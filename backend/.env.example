PORT=3000
NODE_ENV=development

# PostgreSQL / Prisma (required; fetch the connection string from your database provider)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindcraft?schema=public

# Clerk (required for authenticated API requests; fetch both values from Clerk Dashboard)
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Redis / BullMQ / Socket.io adapter (local default; use your managed Redis URL in production)
REDIS_URL=redis://localhost:6379
SOCKET_IO_PATH=/socket.io
SOCKET_IO_CORS_ORIGIN=http://localhost:5173
CHAT_PERSISTENCE_CONCURRENCY=10
WEEKLY_AUDIT_CRON=0 0 * * 0
WEEKLY_AUDIT_TIMEZONE=Asia/Kolkata
WEEKLY_AUDIT_BATCH_SIZE=250
WEEKLY_AUDIT_CONCURRENCY=1
WEEKLY_AUDIT_MAX_ATTEMPTS=3

# HTTP/session configuration
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# Transitional integrations still required by unmigrated route surfaces.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=20
FIREBASE_SERVICE_ACCOUNT_JSON=

# Sarvam AI (required by voice/study-hint routes; fetch the API key from Sarvam)
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_CHAT_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_MAX_AUDIO_BYTES=10485760
SARVAM_STT_TIMEOUT_MS=30000
SARVAM_STT_MAX_ATTEMPTS=2
SARVAM_CHAT_TIMEOUT_MS=10000
SARVAM_CHAT_MAX_ATTEMPTS=3
SARVAM_RETRY_BASE_DELAY_MS=250
SARVAM_RETRY_MAX_DELAY_MS=3000
SARVAM_HINT_FALLBACK=true

# Optional Google Calendar/Meet integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_CALLBACK_URL=/api/auth/google/callback

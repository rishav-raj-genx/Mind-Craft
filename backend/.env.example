# ─────────────────────────────────────────────
# Mindcraft Backend — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
# Download serviceAccountKey.json from Firebase Console:
# Project Settings → Service Accounts → Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://mind-craft-4f16c-default-rtdb.firebaseio.com

# Neo4j (Aura Free Tier or Local Docker)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text

# Google Calendar API (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# CORS
CORS_ORIGIN=http://localhost:5173

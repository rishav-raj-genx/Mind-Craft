{
  "name": "mindcraft-backend",
  "version": "1.0.0",
  "description": "Production-grade Express.js and Prisma backend for Mindcraft P2P college tutoring platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "workflow:weekly-audit": "node src/workflows/weeklyAudit.js",
    "worker:chat": "node src/workers/chatPersistenceWorker.js",
    "worker:weekly-audit": "node src/workers/weeklyAuditWorker.js",
    "scheduler:weekly-audit": "node src/workers/weeklyAuditWorker.js --scheduler",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "mindcraft",
    "p2p-tutoring",
    "prisma",
    "clerk",
    "sarvam-ai",
    "socketio"
  ],
  "author": "Mindcraft Team",
  "license": "MIT",
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@prisma/client": "^6.17.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.1",
    "jest": "^30.2.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.17.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "supertest": "^7.1.4",
    "svix": "^1.76.0",
    "uuid": "^11.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

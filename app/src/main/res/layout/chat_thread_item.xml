<?xml version="1.0" encoding="utf-8"?>
<!-- chat_thread_item.xml — Single chat thread in the chat list -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_md">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivThreadPhoto"
        android:layout_width="@dimen/profile_photo_medium"
        android:layout_height="@dimen/profile_photo_medium"
        android:src="@drawable/ic_placeholder_profile"
        app:civ_border_color="@color/indigo_light"
        app:civ_border_width="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvThreadName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?colorOnSurface"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLastMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="@dimen/text_md" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvThreadTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?colorOnSurfaceVariant"
            android:textSize="@dimen/text_xs" />

        <TextView
            android:id="@+id/tvUnreadCount"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_status_badge"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

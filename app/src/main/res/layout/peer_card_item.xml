<?xml version="1.0" encoding="utf-8"?>
<!-- peer_card_item.xml — Individual peer card in the bottom sheet RecyclerView -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/corner_radius_md"
    app:cardElevation="@dimen/card_elevation_sm"
    app:contentPadding="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Profile photo -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivPeerPhoto"
            android:layout_width="@dimen/profile_photo_medium"
            android:layout_height="@dimen/profile_photo_medium"
            android:src="@drawable/ic_placeholder_profile"
            app:civ_border_color="@color/indigo_light"
            app:civ_border_width="1dp" />

        <!-- Peer info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPeerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurface"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPeerCollege"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="@dimen/text_sm" />

            <!-- Skill badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTeaches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_xs" />

                <TextView
                    android:id="@+id/tvWants"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:background="@drawable/bg_indigo_button"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_xs"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>
        </LinearLayout>

        <!-- Distance and rating -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurfaceVariant"
                android:textSize="@dimen/text_sm" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:src="@android:drawable/btn_star_big_on"
                    android:contentDescription="@string/average_rating" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textColor="@color/star_yellow"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml — Mind Craft
    Declares all activities, services, permissions, and metadata for the app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for Firebase and network calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fine location for Google Maps peer markers (Optional if maps not used, but kept for location services) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Coarse location as fallback -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.MindCraft"
        tools:targetApi="34">

        <!-- Splash Screen — entry point of the app -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MindCraft.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Screen — Google Sign-In -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- Profile Setup — first-time user onboarding -->
        <activity
            android:name=".activities.ProfileSetupActivity"
            android:exported="false" />

        <!-- Main Screen — hosts bottom navigation and fragments -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Chat Screen — individual conversation -->
        <activity
            android:name=".activities.ChatActivity"
            android:exported="false" />

        <!-- Peer Profile Screen — view another user's profile -->
        <activity
            android:name=".activities.PeerProfileActivity"
            android:exported="false" />

        <!-- My Profile Screen — view/edit own profile -->
        <activity
            android:name=".activities.MyProfileActivity"
            android:exported="false" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".services.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>

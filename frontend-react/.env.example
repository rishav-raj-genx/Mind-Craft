# Clerk publishable key (required; fetch it from Clerk Dashboard)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Local backend defaults; replace with the deployed API/Socket.io origin in production.
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_BASE_URL=ws://localhost:3000

# Transitional Firebase Cloud Messaging variables. Remove after NotificationContext
# is migrated fully to Clerk and Socket.io.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
